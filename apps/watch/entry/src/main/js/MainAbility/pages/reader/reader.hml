<div class="screen" style="background-color: {{ theme === 'day' ? '#f5f4f0' : '#101114' }};">
  <!-- 1×1 隐形表冠代理：不在正文显示任何控件。 -->
  <slider class="proxy-slider" ref="crownProxy"
          min="0" max="6" onchange="onCrownChange"></slider>

  <!-- 阅读态：只有正文（issue #11：Canvas 圆形测字排版，不再用方形 list-item）。
       左滑进设置，右滑留给 GT4 系统返回；
       两侧点按翻页，长按也可进入设置，均无可见按钮。 -->
  <div class="reading-area" if="{{ !settingsOpen }}"
       onswipe="onReadingSwipe" onclick="onReaderTap"
       onlongpress="openSettings">
    <canvas ref="readerCanvas" class="reader-canvas"></canvas>
    <text class="read-error" if="{{ readingError }}">{{ body }}</text>
  </div>

  <!-- 同一路由内的设置页：点击“继续阅读”返回原位置；
       不抢占系统右滑返回手势。 -->
  <div class="settings-area" if="{{ settingsOpen }}">
    <text class="settings-heading">阅读设置</text>
    <text class="settings-book">{{ title }}</text>
    <div class="settings-row">
      <div class="settings-action" onclick="fontSmaller"><text class="settings-label">A−</text></div>
      <text class="settings-value">{{ fontSize }}px</text>
      <div class="settings-action" onclick="fontLarger"><text class="settings-label">A+</text></div>
    </div>
    <div class="settings-row">
      <div class="settings-action" onclick="spacingTighter"><text class="settings-label">行距−</text></div>
      <text class="settings-value">{{ lineHeightRatio }}</text>
      <div class="settings-action" onclick="spacingLooser"><text class="settings-label">行距+</text></div>
    </div>
    <div class="settings-wide-action" onclick="toggleTheme">
      <text class="settings-label">{{ theme === 'day' ? '切换夜间模式' : '切换日间模式' }}</text>
    </div>
    <div class="settings-wide-action" onclick="closeSettings">
      <text class="settings-label">继续阅读</text>
    </div>
    <div class="settings-wide-action" onclick="backToLibrary">
      <text class="settings-label">返回书架</text>
    </div>
    <text class="settings-hint">{{ pageHint }}</text>
  </div>
</div>
