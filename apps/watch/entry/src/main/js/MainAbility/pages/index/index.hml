<div class="screen">
  <div class="panel">
    <text class="heading">{{ title }}</text>
    <!-- 内置书单在 onInit 同步渲染；外部书目后台合入。 -->
    <!-- issue #10 真机修复：改用 <list>/<list-item> 实际列表容器，
         否则动态 for 内容在真机上不显示（只见"书架就绪（N 本）"）。 -->
    <list class="book-list">
      <list-item class="book-item" for="{{ books }}" tid="bookId">
        <div class="book-row">
          <div class="book-info" onclick="openBook($idx)">
            <text class="book-title">{{ $item.title }}</text>
            <text class="book-meta">{{ $item.origin === 'builtin' ? '内置' : '手机' }} · {{ $item.bytes }} 字节</text>
          </div>
          <text class="book-delete" onclick="askDelete($idx)" if="{{ $item.origin !== 'builtin' }}">{{ $item.bookId === confirmId ? '确认删除' : '删除' }}</text>
        </div>
      </list-item>
    </list>
    <text class="empty" if="{{ books.length === 0 }}">书架为空：可让手机传书，或用 WATCH_BOOKS_DIR 内置 TXT</text>
    <text class="hint">{{ status }}</text>
    <text class="foot">{{ transferStatus }}</text>
  </div>
</div>
